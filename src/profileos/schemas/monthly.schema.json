{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "kind",
  "month",
  "timezone",
  "coverage",
  "metrics",
  "per_project",
  "languages",
  "repos_included_at_month_end"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "kind": {
   "const": "monthly"
  },
  "month": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "timezone": {
   "type": "string"
  },
  "coverage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "days_in_month",
    "closed_days_covered",
    "first_day",
    "last_day",
    "missing_days",
    "complete"
   ],
   "properties": {
    "days_in_month": {
     "type": "integer",
     "minimum": 28,
     "maximum": 31
    },
    "closed_days_covered": {
     "type": "integer",
     "minimum": 0
    },
    "first_day": {
     "type": [
      "string",
      "null"
     ]
    },
    "last_day": {
     "type": [
      "string",
      "null"
     ]
    },
    "missing_days": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     }
    },
    "complete": {
     "type": "boolean"
    }
   }
  },
  "metrics": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "commits",
    "active_repos",
    "merged_prs",
    "releases"
   ],
   "properties": {
    "commits": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "value"
     ],
     "properties": {
      "statistic": {
       "type": "string",
       "maxLength": 200
      },
      "value": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      }
     }
    },
    "active_repos": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "value"
     ],
     "properties": {
      "statistic": {
       "type": "string",
       "maxLength": 200
      },
      "value": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      }
     }
    },
    "merged_prs": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "value"
     ],
     "properties": {
      "statistic": {
       "type": "string",
       "maxLength": 200
      },
      "value": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      "lower_bound": {
       "type": "boolean"
      }
     }
    },
    "releases": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "statistic",
      "value"
     ],
     "properties": {
      "statistic": {
       "type": "string",
       "maxLength": 200
      },
      "value": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      "lower_bound": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "per_project": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "commits"
    ],
    "properties": {
     "commits": {
      "type": "integer",
      "minimum": 0
     }
    }
   }
  },
  "languages": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "statistic",
    "as_of",
    "items"
   ],
   "properties": {
    "statistic": {
     "type": "string"
    },
    "as_of": {
     "type": [
      "string",
      "null"
     ]
    },
    "items": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "language",
       "pct"
      ],
      "properties": {
       "language": {
        "type": "string",
        "maxLength": 24
       },
       "pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       }
      }
     }
    }
   }
  },
  "repos_included_at_month_end": {
   "type": [
    "integer",
    "null"
   ],
   "minimum": 0
  }
 }
}